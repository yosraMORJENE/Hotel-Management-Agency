{% extends 'base.html.twig' %}

{% block title %}Edit guest — Morjena Agency{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit guest</h1>
            <p class="page-subtitle">Update profile for <span class="fw-semibold">{{ client.nom }}</span>.</p>
        </div>
    </div>

    <div class="card card-soft">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-brand">Save changes</button>
                <a href="{{ path('client_list') }}" class="btn btn-secondary">Back</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
