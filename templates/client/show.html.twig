{% extends 'base.html.twig' %}

{% block title %}Guest details — Morjena Agency{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1 class="page-title">{{ client.nom }} {{ client.lastName }}</h1>
            <p class="page-subtitle">Guest profile and stay dates.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('client_edit', {'id': client.id}) }}" class="btn btn-primary">Edit</a>
            <a href="{{ path('client_list') }}" class="btn btn-secondary">Back</a>
        </div>
    </div>

    <div class="card card-soft">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted">Pension Type</div>
                    <div class="fw-semibold">{{ client.pensionType ?: '-' }}</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">Persons</div>
                    <div class="fw-semibold">{{ client.nbrPersonne }}</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">Email</div>
                    <div class="fw-semibold">{{ client.email }}</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">Property</div>
                    <div class="fw-semibold">{{ client.hotel.nomHotel }}</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">Arrival</div>
                    <div class="fw-semibold">{{ client.dateArrivee|date('Y-m-d H:i') }}</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">Departure</div>
                    <div class="fw-semibold">{{ client.dateDepart|date('Y-m-d H:i') }}</div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}