{% extends 'base.html.twig' %}

{% block title %}Hotels — Morjena Agency{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Hotels</h1>
            <p class="page-subtitle">Hotels Properties</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('hotel_add') }}" class="btn btn-brand">
                <i class="fa-solid fa-circle-plus me-1"></i> Add Hotel
            </a>
        </div>
    </div>

    <div class="card card-soft">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Capacity</th>
                            <th>Price</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for hotel in hotels %}
                            <tr>
                                <td class="text-muted">#{{ hotel.id }}</td>
                                <td class="fw-semibold">{{ hotel.nomHotel }}</td>
                                <td>{{ hotel.address ?: '-' }}</td>
                                <td>{{ hotel.capacity }}</td>
                                <td>{{ hotel.price }}</td>
                                <td class="text-end">
                                    <a href="{{ path('hotel_show', {'id': hotel.id}) }}" class="btn btn-secondary btn-sm">View</a>
                                    <a href="{{ path('hotel_edit', {'id': hotel.id}) }}" class="btn btn-primary btn-sm">Edit</a>
                                    <a href="{{ path('hotel_delete', {'id': hotel.id}) }}" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this hotel?');">Delete</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}