{% extends 'base.html.twig' %}

{% block title %}Add property — Morjena Agency{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1 class="page-title">Add property</h1>
            <p class="page-subtitle">Create a new hotel listing for your agency portfolio.</p>
        </div>
    </div>

    <div class="card card-soft">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_widget(form) }}
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-brand">Create</button>
                <a href="{{ path('hotel_list') }}" class="btn btn-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
