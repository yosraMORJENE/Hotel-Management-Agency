<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Morjena Agency{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}app-shell{% endblock %}">

{% block navbar %}
<nav class="navbar navbar-expand-lg app-navbar sticky-top">
    <div class="container-fluid px-3 px-md-4">
        <a class="navbar-brand app-brand d-flex align-items-center gap-2" href="{{ path('hotel_list') }}">
            <span class="brand-mark" aria-hidden="true">
                <img class="brand-logo" src="{{ asset('images/black-and-white-fish-logo-vector.jpg') }}" alt="Morjena Agency logo">
            </span>
            <span class="brand-text">Morjena <span class="brand-accent">Agency</span></span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav" aria-controls="appNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="appNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('hotel_list') }}">
                            Our Hotels
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('client_list') }}">
                            Guests
                        </a>
                    </li>
                {% endif %}
            </ul>

            <div class="d-flex gap-2 align-items-center">
                {% if app.user %}
                    <div class="dropdown">
                        <button class="btn btn-outline-brand dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fa-regular fa-circle-user me-1"></i>
                            {{ app.user.fullName is defined and app.user.fullName ? app.user.fullName : app.user.email }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a class="btn btn-outline-brand" href="{{ path('app_login') }}">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Sign in
                    </a>
                    <a class="btn btn-brand" href="{{ path('app_register') }}">
                        <i class="fa-solid fa-user-plus me-1"></i> Create account
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
{% endblock %}

{% block page_wrapper %}
<main class="app-main">
    <div class="container app-container py-4">
        {% block flash_messages %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">{{ message }}</div>
            {% endfor %}
        {% endblock %}

        {% block body %}{% endblock %}
    </div>
</main>
{% endblock %}

{% block footer %}
<footer class="app-footer">
    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2">
            <div class="footer-brand">
                <span class="brand-mark" aria-hidden="true">
                    <img class="brand-logo" src="{{ asset('images/black-and-white-fish-logo-vector.jpg') }}" alt="Morjena Agency logo">
                </span>
                <span>Morjena Agency</span>
            </div>
            <div class="footer-note">Hotel & guest management • {{ "now"|date("Y") }}</div>
        </div>
    </div>
</footer>
{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
